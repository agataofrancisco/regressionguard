<!doctype html>
<html lang="pt-PT">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}RegressionGuard{% endblock %}</title>
<style>
:root {
  --bg: #fafaf9; --fg: #1c1917; --muted: #57534e; --card: #ffffff; --line: #e7e5e4;
  --ok: #15803d; --bad: #b91c1c; --warn: #b45309; --accent: #1d4ed8; --code: #f5f5f4;
}
:root[data-theme="dark"] {
  --bg: #0c0a09; --fg: #f5f5f4; --muted: #a8a29e; --card: #1c1917; --line: #292524;
  --ok: #4ade80; --bad: #f87171; --warn: #fbbf24; --accent: #93c5fd; --code: #1c1917;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0c0a09; --fg: #f5f5f4; --muted: #a8a29e; --card: #1c1917; --line: #292524;
    --ok: #4ade80; --bad: #f87171; --warn: #fbbf24; --accent: #93c5fd; --code: #1c1917;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.5 system-ui, sans-serif; }
main { max-width: 1100px; margin: 0 auto; padding: 16px; }
h1 { font-size: 1.5rem; margin: 8px 0 4px; }
h2 { font-size: 1.15rem; margin: 28px 0 8px; border-bottom: 1px solid var(--line); padding-bottom: 4px; }
a { color: var(--accent); }
.muted { color: var(--muted); font-size: 0.9rem; }
.banner { border: 1px solid var(--warn); color: var(--warn); padding: 8px 12px; border-radius: 6px; margin: 12px 0; }
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; margin: 12px 0; }
.card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; }
.card .label { color: var(--muted); font-size: 0.8rem; }
.card .value { font-size: 1.25rem; font-weight: 600; }
table { width: 100%; border-collapse: collapse; background: var(--card); }
th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { color: var(--muted); font-weight: 600; font-size: 0.85rem; }
pre, code { background: var(--code); border-radius: 4px; font-size: 0.85rem; }
pre { padding: 8px; overflow-x: auto; white-space: pre-wrap; word-break: break-word; }
.pass { color: var(--ok); font-weight: 600; }
.fail { color: var(--bad); font-weight: 600; }
.na { color: var(--muted); font-weight: 600; }
.wrap { overflow-x: auto; }
@media (max-width: 600px) { main { padding: 12px; } th, td { font-size: 0.85rem; } }
</style>
</head>
<body>
<main>
<p class="muted"><a href="{{ index_href }}">&larr; Índice de runs</a></p>
{% block content %}{% endblock %}
</main>
</body>
</html>
